# MAILLON — variables d'environnement (template, ne pas committer .env)
# Hébergement cible : UE (Scaleway Paris primaire, OVH Roubaix backup).

# ─── Public (safe pour le client, exposé à React) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://maillon.fr
NEXT_PUBLIC_APP_URL=https://app.maillon.fr

# ─── Base de données : PostgreSQL 16 + TimescaleDB + PostGIS ─────────────
# En prod : connexion via pgBouncer (transaction pooling) recommandée.
# DATABASE_URL=postgresql://maillon_app:CHANGE_ME@db.scaleway-internal:5432/maillon?schema=public&sslmode=require
DATABASE_URL=

# ─── Auth : Better-Auth ──────────────────────────────────────────────────
# Secret >= 32 caractères, généré via : openssl rand -base64 48
# BETTER_AUTH_SECRET=
BETTER_AUTH_SECRET=

# ─── MQTT : EMQX self-hosted UE ──────────────────────────────────────────
# Le bridge `lib/mqtt-bridge.ts` consomme `${MQTT_TOPIC_ROOT}/{org_id}/{node_id}/+`.
# MQTT_BROKER_URL=mqtts://broker.maillon.fr:8883
MQTT_BROKER_URL=
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_ROOT=maillon

# Token Bearer partagé entre le bridge et l'API d'ingestion (POST /api/v1/positions).
# Doit être différent du secret Better-Auth. Rotater au moins une fois par an.
# MQTT_INGEST_TOKEN=
MQTT_INGEST_TOKEN=

# ─── E-mail transactionnel (Resend ou Mailtrap UE) ───────────────────────
# RESEND_API_KEY=re_...

# ─── Paiement (Stripe) ───────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
