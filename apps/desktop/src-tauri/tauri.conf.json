{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAILLON Console",
  "version": "0.1.0",
  "identifier": "fr.maillon.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MAILLON Console",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#1A1F1C",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Console opérateur du réseau mesh MAILLON",
    "longDescription": "Application de supervision et de pilotage du réseau mesh radio MAILLON. Permet de visualiser les nœuds connectés, d'envoyer des messages chiffrés et de gérer la flotte d'équipements Meshtastic.",
    "copyright": "© MAILLON",
    "publisher": "MAILLON",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "providerShortName": "MAILLON"
    },
    "windows": {
      "wix": { "language": ["fr-FR", "en-US"] },
      "nsis": { "languages": ["French", "English"] }
    }
  },
  "plugins": {}
}
